# Wired tests configuration
KNX_loglevel=trace
KNX_ipAddr=192.168.8.4
KNX_port=3671
KNX_physAddr=14.14.14

# DPT1 group address pair (binary status) to test write/read/respond
KNX_dpt1_status_ga=1/1/1
KNX_dpt1_control_ga=1/1/101

# DPT9 group address (temperature) that should respond to a GroupValue_Read request
KNX_dpt9_temperature_status_ga=0/0/15

# DPT9 timer control and status group addresses
KNX_dpt9_timer_control_ga=4/1/4
KNX_dpt9_timer_status_ga=4/1/3

# DPT232 RGB control and status group addresses
KNX_dpt232_rgb_control_ga=5/0/30
KNX_dpt232_rgb_status_ga=5/0/31

# DPT251 RGBW control and status group addresses
KNX_dpt251_rgbw_control_ga=5/0/40
KNX_dpt251_rgbw_status_ga=5/0/41

# DPT1 group address that should also respond to a GroupValue_Read request
KNX_wired_test_control_ga=5/0/0

# Read storm test: read back statuses from an actuator with multiple relays
KNX_readstorm_control_ga_start=1/1/0
KNX_readstorm_status_ga_start=1/1/100
KNX_readstorm_range=8
